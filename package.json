{
  "name": "@benmacha/doctrine-diagram",
  "version": "2.0.0",
  "description": "Interactive Doctrine entity diagram (React) — usable as a React component, a Vue component, a Web Component or a plain script. Front-end of benmacha/diagram-bundle.",
  "license": "MIT",
  "author": "Ali Ben Macha <contact@benmacha.tn>",
  "repository": "github:BenMacha/diagram-bundle",
  "type": "module",
  "sideEffects": [
    "./src/Resources/public/build/element.mjs",
    "./src/Resources/public/build/diagram.js"
  ],
  "main": "./src/Resources/public/build/index.mjs",
  "module": "./src/Resources/public/build/index.mjs",
  "types": "./assets/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./assets/types/index.d.ts",
      "import": "./src/Resources/public/build/index.mjs"
    },
    "./element": {
      "types": "./assets/types/element.d.ts",
      "import": "./src/Resources/public/build/element.mjs"
    },
    "./vue": {
      "types": "./assets/types/vue.d.ts",
      "import": "./src/Resources/public/build/vue.mjs"
    },
    "./standalone": "./src/Resources/public/build/diagram.js",
    "./style.css": "./src/Resources/public/build/diagram.css"
  },
  "files": [
    "src/Resources/public/build",
    "assets/types"
  ],
  "scripts": {
    "build": "node assets/build.mjs",
    "typecheck": "tsc --noEmit -p assets/tsconfig.json",
    "test": "vitest run --root assets"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vue": "^3.2"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "vue": { "optional": true }
  },
  "devDependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^15.11.7",
    "react": "^18.3.1",
    "react-dom": "^19.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  }
}
